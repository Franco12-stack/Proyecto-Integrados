# --- Odoo Postgres (usuario solo lectura) ---
ODOO_PG_HOST=
ODOO_PG_PORT=5432
ODOO_PG_DATABASE=
ODOO_PG_USER=
ODOO_PG_PASSWORD=
# Nombre de la lista de precios de Odoo a usar (pricelist.id o nombre)
ODOO_PRICELIST_ID=

# --- App ---
PORT=3000
DATABASE_FILE=./data/store_tokens.sqlite

# Descuento automático que Tienda Nube aplica al elegir Transferencia/Depósito
# (Configuración → Medios de pago). Necesario para no restarlo dos veces al
# calcular el cupón del Draft Order.
NATIVE_TRANSFER_DISCOUNT_RATE=0.25

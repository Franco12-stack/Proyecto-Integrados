# Copia este archivo a .env y completa tus valores.
# .env esta en .gitignore: NUNCA lo subas al repo.

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Debe coincidir EXACTO con DEVICE_TOKEN en src/config/Secrets.h
DEVICE_TOKEN=cambia-esto-por-algo-largo-y-random

# Modelo de Claude a usar para interpretar comandos (rapido y barato
# alcanza de sobra para esta tarea de clasificacion simple).
CLAUDE_MODEL=claude-sonnet-4-6
